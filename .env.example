# ==============================================================================
# BESS <-> EMS Simulator Environment Configuration
# ==============================================================================

# Database (PostgreSQL + TimescaleDB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ems
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ems

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60

# EMS Core Service
EMS_HOST=0.0.0.0
EMS_PORT=8000
LOG_LEVEL=INFO
EMS_API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]

# Simulation Clock Defaults
SIM_SPEED=60
SIM_START_TIME=2026-03-01T00:00:00Z
SIM_TICK_SECONDS=60

# BESS Simulator Service
BESS_ID=bess-01
BESS_SIM_TELEMETRY_INTERVAL_MS=1000

# Web UI
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
