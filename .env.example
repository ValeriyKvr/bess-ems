# ==============================================================================
# BESS <-> EMS Simulator Environment Configuration
# ==============================================================================

# Database (PostgreSQL + TimescaleDB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ems
# Compose service name of the database container (see docker-compose.yml)
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@timescaledb:5432/ems
# Host port the timescaledb container is published on. 5433 by default so the stack
# still starts when a natively installed PostgreSQL already owns 5432.
POSTGRES_HOST_PORT=5433

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60

# EMS Core Service
EMS_HOST=0.0.0.0
EMS_PORT=8000
LOG_LEVEL=INFO
EMS_API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]

# Simulation Clock Defaults
SIM_SPEED=60
SIM_START_TIME=2026-09-01T00:00:00Z
SIM_TICK_SECONDS=60

# BESS Simulator Service
BESS_ID=bess-01
BESS_SIM_TELEMETRY_INTERVAL_MS=1000
# Optional startup overrides for the physical battery model. At runtime the EMS
# republishes these from the Settings page over MQTT (topic ems/{id}/config).
# BATTERY__CAPACITY_KWH=1000
# BATTERY__POWER_MAX_KW=500
# BATTERY__TEMP_AMBIENT_C=25

# Web UI
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
